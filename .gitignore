# Environments
.env
venv/
node_modules/
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Output & Work directories
work/
output/
logs/
.thumbnails/

# Temp / Input files
*.ogg
temp.ogg
*.pptx

# Sample/output videos at repo root (do not commit large media)
/*.mp4

# Inbox (Exclude content inside inbox except .gitkeep)
inbox/*
!inbox/.gitkeep

# Exclude generated assets in hyperframes app
hyperframes-app/assets/*
!hyperframes-app/assets/.gitkeep

# Generated composition (regenerated by src/main.py on every run)
hyperframes-app/index.html

# BGM audio files are NOT committed (this repo is public; free-music licenses forbid redistribution).
# Keep the folder structure + LICENSES.md, add the music locally per machine (see assets/bgm/README.md)
assets/bgm/*/*
!assets/bgm/*/.gitkeep

# Voice recordings for cloning (personal biometric data; never commit)
assets/voice/
voice-sample/
