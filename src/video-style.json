{
  "design": {
    "font_family": "Noto Sans JP, sans-serif",
    "font_weight": "bold",
    "text_color": "#FFFFFF",
    "stroke_color": "#000000",
    "stroke_width": 4,
    "highlight_color": "#FFD700"
  },
  "animation": {
    "subtitle_transition": "fade",
    "subtitle_max_lines": 2,
