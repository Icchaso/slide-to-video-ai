{
  "design": {
    "font_family": "Noto Sans JP, sans-serif",
    "text_color": "#FFFFFF",
    "stroke_color": "#000000",
    "highlight_color": "#FFD700",
    "subtitles_enabled": true,
    "subtitle_font_size": 52,
    "subtitle_background": "band",
    "subtitle_max_chars_per_line": 16,
    "subtitle_max_lines": 2,
    "subtitle_position": "band",
    "subtitle_band_height": 216,
    "intro_label": "VIDEO GUIDE",
    "card": {
      "bg_a": "#0b1020",
      "bg_b": "#101830",
      "accent_a": "#5a8cff",
      "accent_b": "#00c8ff"
    }
  },
  "animation": {
    "slide_transition": "crossfade",
    "transition_duration": 0.6,
    "ken_burns": false,
    "ken_burns_zoom": 1.06,
    "subtitle_lead_time": 0.08,
    "focus_padding": 14,
    "focus_max_zoom": 1.8,
    "focus_lead": 0.15
  },
  "intro": {
    "enabled": true,
    "duration": 3.0
  },
  "outro": {
    "enabled": true,
    "duration": 4.0,
    "text": "ご視聴ありがとうございました"
  },
  "audio": {
    "tts_granularity": "sentence",
    "sentence_gap": 0.18,
    "min_sentence_chars": 6,
    "tts_speed": 1.0,
    "tts_temperature": 0.5,
    "fish_model": "s2.1-pro",
    "edge_voice": "ja-JP-NanamiNeural",
    "lead_silence": 0.25,
    "tail_silence": 0.6,
    "bgm_mood": "auto",
    "bgm_volume_db": -18,
    "bgm_crossfade": 2.0,
    "bgm_min_length_sec": 15,
    "duck_threshold": 0.03,
    "duck_ratio": 8,
    "duck_attack_ms": 20,
    "duck_release_ms": 400,
    "fade_in_duration": 2.0,
    "fade_out_duration": 4.0,
    "loudness_target_lufs": -14,
    "loudness_true_peak": -1.5
  },
  "sfx": {
    "enabled": true,
    "transition_file": "whoosh-short.mp3",
    "transition_volume": 0.22,
    "intro_file": "impact-bass-1.mp3",
    "intro_volume": 0.35
  },
  "transcribe": {
    "enabled": false,
    "model": "small",
    "language": "ja"
  },
  "qa": {
    "duration_tolerance_sec": 1.5,
    "loudness_tolerance_warn": 0.7,
    "loudness_tolerance_fail": 1.5,
    "true_peak_fail_dbtp": -1.0,
    "bgm_lra_min": 1.2,
    "contact_sheet_frames": 12
  },
  "bgm_search": {
    "enabled": true,
    "count": 3,
    "licenses": [
      "by",
      "cc0"
    ],
    "min_seconds": 30,
    "max_seconds": 360,
    "preview_seconds": 20,
    "page_size": 20,
    "queries": {
      "relaxing": [
        "calm",
        "ambient",
        "acoustic",
        "relaxing"
      ],
      "upbeat": [
        "upbeat",
        "happy",
        "corporate",
        "energetic"
      ],
      "serious": [
        "inspiring",
        "documentary",
        "piano",
        "cinematic"
      ]
    },
    "timeout_seconds": 45,
    "max_queries": 3
  },
  "presets": {
    "modern": {},
    "pop": {
      "design": {
        "highlight_color": "#FFE14D",
        "intro_label": "LET'S START",
        "card": {
          "bg_a": "#1a0f2e",
          "bg_b": "#2a1545",
          "accent_a": "#ff6ea8",
          "accent_b": "#ffb347"
        }
      },
      "animation": {
        "transition_duration": 0.45,
        "ken_burns_zoom": 1.07
      },
      "audio": {
        "bgm_mood": "upbeat",
        "bgm_volume_db": -16
      }
    },
    "calm": {
      "design": {
        "intro_label": "GUIDE",
        "card": {
          "bg_a": "#0c1a16",
          "bg_b": "#12261f",
          "accent_a": "#3cc8a0",
          "accent_b": "#8fd9c0"
        }
      },
      "animation": {
        "transition_duration": 0.9,
        "ken_burns_zoom": 1.04
      },
      "audio": {
        "bgm_mood": "relaxing",
        "bgm_volume_db": -20
      },
      "sfx": {
        "transition_volume": 0.12
      }
    },
    "serious": {
      "design": {
        "highlight_color": "#7fd0ff",
        "intro_label": "REPORT",
        "card": {
          "bg_a": "#0a0f18",
          "bg_b": "#131c2c",
