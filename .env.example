# ===== Fish Audio（高品質・有料TTS。未設定なら無料の edge-tts に自動フォールバック） =====
# APIキー: https://fish.audio/ → Settings → API Keys
FISH_AUDIO_API_KEY="your_api_key_here"

# クローン音声を使う場合、Fish Audio の Model ID（reference_id）を貼り付け
FISH_AUDIO_VOICE_ID=""

# 使用モデル（省略時 s2.1-pro）。選択肢: s1 / s2-pro / s2.1-pro / s2.1-pro-free
# FISH_AUDIO_MODEL="s2.1-pro"
